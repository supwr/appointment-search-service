scalar DateTime
scalar Long

type Appointment {
  appointmentId: ID!
  patientId: ID!
  doctorId: ID!
  appointmentDateTime: DateTime!
  idempotencyKey: String
  createdAt: DateTime!
  updatedAt: DateTime!
}

type AppointmentPage {
  content: [Appointment!]!
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
}

input AppointmentSearchFilter {
  from: DateTime
  to: DateTime
  page: Int = 0
  size: Int = 20
}

type Query {
  appointmentsByPatient(patientId: ID!, filter: AppointmentSearchFilter): AppointmentPage!
  myAppointments(filter: AppointmentSearchFilter): AppointmentPage!
}
